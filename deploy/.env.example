# AEGIS Local Development Stack — Environment Variables
#
# Copy this file to .env and fill in the values before running:
#   cp .env.example .env
#
# docker compose will automatically load .env from the same directory.

# ─── LLM Provider ────────────────────────────────────────────────────────────
# The aegis-config.yaml shipped here uses Ollama (local, no key required).
# To use OpenAI instead, add this and update aegis-config.yaml accordingly.
# OPENAI_API_KEY=sk-...

# ─── Keycloak ─────────────────────────────────────────────────────────────────
# Bootstrap admin password for the local Keycloak instance.
# Change this in any non-throwaway environment.
KEYCLOAK_ADMIN_PASSWORD=admin

# ─── AEGIS Runtime Networking ─────────────────────────────────────────────────
# Docker network shared between AEGIS and agent containers.
AEGIS_DOCKER_NETWORK=aegis-network

# URL the aegis-runtime service is reachable at (from inside Docker).
AEGIS_ORCHESTRATOR_URL=http://aegis-runtime:8088

# NFS server host for agent volume mounts (accessed by the Docker *daemon*, not
# the container network — so container names like "aegis-runtime" do NOT work).
#
# Platform               → value
# Linux native / WSL2    → 127.0.0.1   (requires port 2049 exposed to host)
# Docker Desktop Win/Mac → host.docker.internal
# Linux bridge network   → 172.17.0.1  (Docker bridge gateway)
# Remote / VM host       → <physical host IP>
#
# Uncomment and set the correct value for your platform:
# AEGIS_NFS_HOST=127.0.0.1

# ─── Secrets Management (OpenBao) ─────────────────────────────────────────────
# Pre-configured Secret ID for local development AppRole authentication
OPENBAO_SECRET_ID=test-secret-id

# ─── LLM Provider API Keys ───────────────────────────────────────────────────
# Required if using Anthropic models in aegis-config.yaml
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Runtime ──────────────────────────────────────────────────────────────────
# Keep agent containers after execution for debugging (default: false)
AEGIS_KEEP_CONTAINER=false
