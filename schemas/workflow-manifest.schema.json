{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "AEGIS Workflow Manifest",
    "description": "Schema for workflow.yaml configuration files (K8s-style format)",
    "type": "object",
    "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
    ],
    "properties": {
        "apiVersion": {
            "type": "string",
            "description": "API version following Kubernetes convention",
            "enum": [
                "100monkeys.ai/v1"
            ]
        },
        "kind": {
            "type": "string",
            "description": "Resource kind",
            "enum": [
                "Workflow"
            ]
        },
        "metadata": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Unique workflow name (DNS label format)",
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                    "maxLength": 63
                },
                "version": {
                    "type": "string",
                    "description": "Manifest schema version (semantic versioning)",
                    "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*)?(?:\\+[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*)?$"
                },
                "description": {
                    "type": "string",
                    "description": "Human-readable description"
                },
                "labels": {
                    "type": "object",
                    "description": "Key-value labels for categorization",
                    "additionalProperties": {
                        "type": "string",
                        "maxLength": 63,
                        "pattern": "^[a-zA-Z0-9_.-]+$"
                    }
                },
                "annotations": {
                    "type": "object",
                    "description": "Arbitrary annotations (non-identifying metadata)",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "input_schema": {
                    "type": "object",
                    "description": "JSON Schema (draft-07 object subset) declaring the shape of the workflow's expected input",
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "object"
                        },
                        "properties": {
                            "type": "object"
                        },
                        "required": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "output_schema": {
                    "type": "object",
                    "description": "JSON Schema (draft-07 object subset) declaring the shape of the workflow's output",
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "object"
                        },
                        "properties": {
                            "type": "object"
                        },
                        "required": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "output_template": {
                    "type": "object",
                    "description": "Object where each leaf value is a Handlebars expression evaluated against the final blackboard at workflow completion",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            }
        },
        "spec": {
            "type": "object",
            "required": [
                "initial_state",
                "states"
            ],
            "properties": {
                "initial_state": {
                    "type": "string",
                    "description": "Name of the initial state"
                },
                "context": {
                    "type": "object",
                    "description": "Global context available to all states",
                    "additionalProperties": true
                },
                "storage": {
                    "type": "object",
                    "description": "Workflow-level storage configuration",
                    "properties": {
                        "workspace": {
                            "$ref": "#/definitions/StorageDefinition"
                        },
                        "shared_volumes": {
                            "type": "array",
                            "items": {
                                "allOf": [
                                    {
                                        "$ref": "#/definitions/StorageDefinition"
                                    },
                                    {
                                        "type": "object",
                                        "required": [
                                            "name"
                                        ],
                                        "properties": {
                                            "name": {
                                                "type": "string",
                                                "description": "Unique identifier for the shared volume"
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    }
                },
                "states": {
                    "type": "object",
                    "description": "State machine definition",
                    "minProperties": 1,
                    "patternProperties": {
                        "^[a-zA-Z0-9_]+$": {
                            "$ref": "#/definitions/State"
                        }
                    },
                    "additionalProperties": false
                }
            }
        }
    },
    "definitions": {
        "StorageDefinition": {
            "type": "object",
            "required": [
                "storage_class"
            ],
            "properties": {
                "storage_class": {
                    "type": "string",
                    "enum": [
                        "ephemeral",
                        "persistent"
                    ]
                },
                "ttl_hours": {
                    "type": "integer",
                    "description": "Time-To-Live for auto-deletion (ephemeral only)",
                    "minimum": 1
                },
                "size_limit_mb": {
                    "type": "integer",
                    "description": "Maximum size in megabytes",
                    "minimum": 1
                },
                "volume_id": {
                    "type": "string",
                    "description": "Pre-created volume UUID (persistent only)"
                }
            }
        },
        "VolumeMount": {
            "type": "object",
            "required": [
                "volume",
                "mount_path",
                "access_mode"
            ],
            "properties": {
                "volume": {
                    "type": "string"
                },
                "mount_path": {
                    "type": "string"
                },
                "access_mode": {
                    "type": "string",
                    "enum": [
                        "read-only",
                        "read-write"
                    ]
                }
            }
        },
        "Transition": {
            "type": "object",
            "required": [
                "condition",
                "target"
            ],
            "properties": {
                "condition": {
                    "type": "string",
                    "enum": [
                        "always",
                        "on_success",
                        "on_failure",
                        "exit_code_zero",
                        "exit_code_non_zero",
                        "exit_code",
                        "score_above",
                        "score_below",
                        "score_between",
                        "confidence_above",
                        "consensus",
                        "all_approved",
                        "any_rejected",
                        "input_equals",
                        "input_equals_yes",
                        "input_equals_no",
                        "custom"
                    ]
                },
                "target": {
                    "type": "string"
                },
                "feedback": {
                    "type": "string"
                },
                "value": {},
                "threshold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "min": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "max": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "agreement": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "expression": {
                    "type": "string"
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "condition": {
                                "const": "exit_code"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "value"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "condition": {
                                "enum": [
                                    "score_above",
                                    "score_below",
                                    "confidence_above"
                                ]
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "threshold"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "condition": {
                                "const": "score_between"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "min",
                            "max"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "condition": {
                                "const": "input_equals"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "value"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "condition": {
                                "const": "custom"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "expression"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "condition": {
                                "const": "consensus"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "threshold",
                            "agreement"
                        ]
                    }
                }
            ]
        },
        "AgentState": {
            "type": "object",
            "required": [
                "kind",
                "agent",
                "input",
                "transitions"
            ],
            "properties": {
                "kind": {
                    "type": "string",
                    "enum": [
                        "Agent"
                    ]
                },
                "agent": {
                    "type": "string"
                },
                "input": {
                    "type": "string"
                },
                "isolation": {
                    "type": "string",
                    "enum": [
                        "inherit",
                        "firecracker",
                        "docker",
                        "process"
                    ]
                },
                "timeout": {
                    "type": "string",
                    "pattern": "^\\d+s$"
                },
                "volumes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/VolumeMount"
                    }
                },
                "transitions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Transition"
                    }
                }
            }
        },
        "SystemState": {
            "type": "object",
            "required": [
                "kind",
                "command",
                "transitions"
            ],
            "properties": {
                "kind": {
                    "type": "string",
                    "enum": [
                        "System"
                    ]
                },
                "command": {
                    "type": "string"
                },
                "env": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "workdir": {
                    "type": "string"
                },
                "timeout": {
                    "type": "string",
                    "pattern": "^\\d+s$"
                },
                "transitions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Transition"
                    }
                }
            }
        },
        "HumanState": {
            "type": "object",
            "required": [
                "kind",
                "prompt",
                "transitions"
            ],
            "properties": {
                "kind": {
                    "type": "string",
                    "enum": [
                        "Human"
                    ]
                },
                "prompt": {
                    "type": "string"
                },
                "timeout": {
                    "type": "string",
                    "pattern": "^\\d+s$"
                },
                "default_response": {
                    "type": "string"
                },
                "transitions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Transition"
                    }
                }
            }
        },
        "ParallelAgentsAgentConfig": {
            "type": "object",
            "required": [
                "agent",
                "input"
            ],
            "properties": {
                "agent": {
                    "type": "string"
                },
                "input": {
                    "type": "string"
                },
                "weight": {
                    "type": "number",
                    "default": 1.0
                },
                "timeout_seconds": {
                    "type": "integer",
                    "default": 60
                },
                "poll_interval_ms": {
                    "type": "integer",
                    "default": 500
                }
            }
        },
        "ConsensusConfig": {
            "type": "object",
            "required": [
                "strategy"
            ],
            "properties": {
                "strategy": {
                    "type": "string",
                    "enum": [
                        "weighted_average",
                        "majority",
                        "unanimous",
                        "best_of_n"
                    ]
                },
                "threshold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.7
                },
                "min_agreement_confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "n": {
                    "type": "integer",
                    "minimum": 1
                },
                "min_judges_required": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1
                },
                "confidence_weighting": {
                    "type": "object",
                    "properties": {
                        "agreement_factor": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1,
                            "default": 0.7
                        },
                        "self_confidence_factor": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1,
                            "default": 0.3
                        }
                    }
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "strategy": {
                                "const": "best_of_n"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "n"
                        ]
                    }
                }
            ]
        },
        "ParallelAgentsState": {
            "type": "object",
            "required": [
                "kind",
                "agents",
                "consensus",
                "transitions"
            ],
            "properties": {
                "kind": {
                    "type": "string",
                    "enum": [
                        "ParallelAgents"
                    ]
                },
                "agents": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ParallelAgentsAgentConfig"
                    },
                    "minItems": 1
                },
                "consensus": {
                    "$ref": "#/definitions/ConsensusConfig"
                },
                "timeout": {
                    "type": "string",
                    "pattern": "^\\d+s$"
                },
                "transitions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Transition"
                    }
                }
            }
        },
        "ContainerVolumeMount": {
            "type": "object",
            "required": ["name", "mount_path"],
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Volume name as defined under spec.storage.shared_volumes (or \"workspace\" for the default workspace)"
                },
                "mount_path": {
                    "type": "string",
                    "description": "Absolute path inside the container"
                },
                "read_only": {
                    "type": "boolean",
                    "default": false,
                    "description": "If true, the container cannot write to the volume"
                }
            },
            "additionalProperties": false
        },
        "ContainerResources": {
            "type": "object",
            "properties": {
                "cpu": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "CPU in millicores (1000 = 1 vCPU)"
                },
                "memory": {
                    "type": "string",
                    "description": "Memory limit (e.g. \"512Mi\", \"2Gi\")"
                },
                "timeout": {
                    "type": "string",
                    "description": "Maximum wall-clock time (e.g. \"5m\", \"30m\", \"1h\")"
                }
            },
            "additionalProperties": false
        },
        "RetryConfig": {
            "type": "object",
            "properties": {
                "max_attempts": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1,
                    "description": "Total run attempts including the first"
                },
                "backoff": {
                    "type": "string",
                    "description": "Wait between retry attempts (e.g. \"30s\", \"2m\")"
                }
            },
            "additionalProperties": false
        },
        "ContainerRunStep": {
            "type": "object",
            "required": ["name", "image", "command"],
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Unique step identifier — used as the key in this state's output object"
                },
                "image": {
                    "type": "string",
                    "description": "Container image reference (registry/repo:tag)"
                },
                "image_pull_policy": {
                    "type": "string",
                    "enum": ["Always", "IfNotPresent", "Never"],
                    "default": "IfNotPresent"
                },
                "command": {
                    "type": "array",
                    "items": { "type": "string" },
                    "minItems": 1,
                    "description": "Exec-form command"
                },
                "shell": {
                    "type": "boolean",
                    "default": false,
                    "description": "If true, runs command via /bin/sh -c"
                },
                "env": {
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                },
                "workdir": {
                    "type": "string",
                    "description": "Working directory inside the container"
                },
                "volumes": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/ContainerVolumeMount" }
                },
                "resources": {
                    "$ref": "#/definitions/ContainerResources"
                },
                "registry_credentials": {
                    "type": "string",
                    "description": "OpenBao path to registry credentials (e.g. \"vault:secret/registry-creds\")"
                }
            },
            "additionalProperties": false
        },
        "ContainerRunState": {
            "type": "object",
            "required": ["kind", "image", "command", "transitions"],
            "properties": {
                "kind": {
                    "type": "string",
                    "enum": ["ContainerRun"]
                },
                "name": {
                    "type": "string",
                    "description": "Human-readable label for this step displayed in the Synapse UI and audit logs (e.g. \"Compile and Build\")"
                },
                "image": {
                    "type": "string",
                    "description": "Container image reference (registry/repo:tag)"
                },
                "image_pull_policy": {
                    "type": "string",
                    "enum": ["Always", "IfNotPresent", "Never"],
                    "default": "IfNotPresent"
                },
                "command": {
                    "type": "array",
                    "items": { "type": "string" },
                    "minItems": 1,
                    "description": "Exec-form command (first element is the binary)"
                },
                "shell": {
                    "type": "boolean",
                    "default": false,
                    "description": "If true, runs command joined with spaces via /bin/sh -c"
                },
                "env": {
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                },
                "workdir": {
                    "type": "string",
                    "description": "Working directory inside the container"
                },
                "volumes": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/ContainerVolumeMount" }
                },
                "resources": {
                    "$ref": "#/definitions/ContainerResources"
                },
                "registry_credentials": {
                    "type": "string",
                    "description": "OpenBao path to registry credentials (e.g. \"vault:secret/registry-creds\")"
                },
                "retry": {
                    "$ref": "#/definitions/RetryConfig"
                },
                "transitions": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/Transition" }
                }
            },
            "additionalProperties": false
        },
        "ParallelContainerRunState": {
            "type": "object",
            "required": ["kind", "steps", "transitions"],
            "properties": {
                "kind": {
                    "type": "string",
                    "enum": ["ParallelContainerRun"]
                },
                "steps": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/ContainerRunStep" },
                    "minItems": 1,
                    "description": "Container steps to execute concurrently"
                },
                "completion": {
                    "type": "string",
                    "enum": ["all_succeed", "any_succeed", "best_effort"],
                    "default": "all_succeed",
                    "description": "Exit strategy: all_succeed (default), any_succeed, or best_effort"
                },
                "transitions": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/Transition" }
                }
            },
            "additionalProperties": false
        },
        "State": {
            "oneOf": [
                {
                    "$ref": "#/definitions/AgentState"
                },
                {
                    "$ref": "#/definitions/SystemState"
                },
                {
                    "$ref": "#/definitions/HumanState"
                },
                {
                    "$ref": "#/definitions/ParallelAgentsState"
                },
                {
                    "$ref": "#/definitions/ContainerRunState"
                },
                {
                    "$ref": "#/definitions/ParallelContainerRunState"
                }
            ]
        }
    }
}