{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEGIS Agent Manifest",
  "description": "Schema for agent.yaml configuration files (K8s-style format)",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "description": "API version following Kubernetes convention",
      "enum": [
        "100monkeys.ai/v1"
      ]
    },
    "kind": {
      "type": "string",
      "description": "Resource kind",
      "enum": [
        "Agent"
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique agent name (DNS label format)",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "version": {
          "type": "string",
          "description": "Manifest schema version (semantic versioning)",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description"
        },
        "labels": {
          "type": "object",
          "description": "Key-value labels for categorization",
          "patternProperties": {
            "^[a-z0-9-]+$": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "type": "object",
          "description": "Arbitrary annotations (non-identifying metadata)",
          "patternProperties": {
            "^[a-z0-9-./]+$": {
              "type": "string"
            }
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "runtime"
      ],
      "properties": {
        "output_schema": {
          "type": "object",
          "description": "JSON Schema (draft-07 object subset) declaring the shape of the agent's output",
          "properties": {
            "type": {
              "type": "string",
              "const": "object"
            },
            "properties": {
              "type": "object"
            },
            "required": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "runtime": {
          "type": "object",
          "required": [
            "language",
            "version"
          ],
          "properties": {
            "language": {
              "type": "string",
              "description": "Programming language",
              "enum": [
                "python",
                "javascript",
                "typescript",
                "rust",
                "go"
              ]
            },
            "version": {
              "type": "string",
              "description": "Language version",
              "examples": [
                "3.11",
                "20",
                "1.75"
              ]
            },
            "isolation": {
              "type": "string",
              "description": "Isolation mode",
              "enum": [
                "inherit",
                "firecracker",
                "docker",
                "process"
              ],
              "default": "inherit"
            },
            "model": {
              "type": "string",
              "description": "Model alias for LLM selection (e.g. 'default', 'fast', 'smart'). Must match an alias configured in the node's spec.llm_providers.",
              "default": "default"
            }
          }
        },
        "task": {
          "type": "object",
          "properties": {
            "instruction": {
              "type": "string",
              "description": "High-level task guidance"
            },
            "prompt_template": {
              "type": "string",
              "description": "Custom prompt template"
            },
            "input_data": {
              "type": "object",
              "description": "Structured input parameters"
            }
          }
        },
        "security": {
          "type": "object",
          "properties": {
            "network": {
              "type": "object",
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "type": "string",
                  "description": "Network access policy mode",
                  "enum": [
                    "allow",
                    "deny",
                    "none"
                  ]
                },
                "allowlist": {
                  "type": "array",
                  "description": "Allowed network destinations",
                  "items": {
                    "type": "string"
                  }
                },
                "denylist": {
                  "type": "array",
                  "description": "Denied network destinations",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "filesystem": {
              "type": "object",
              "properties": {
                "read": {
                  "type": "array",
                  "description": "Paths allowed for reading",
                  "items": {
                    "type": "string"
                  }
                },
                "write": {
                  "type": "array",
                  "description": "Paths allowed for writing",
                  "items": {
                    "type": "string"
                  }
                },
                "read_only": {
                  "type": "boolean",
                  "description": "Read-only mode",
                  "default": false
                }
              }
            },
            "resources": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "integer",
                  "description": "CPU limit in millicores (1000 = 1 core)",
                  "minimum": 100,
                  "maximum": 4000,
                  "default": 1000
                },
                "memory": {
                  "type": "string",
                  "description": "Memory limit (e.g., 512Mi, 1Gi)",
                  "pattern": "^\\d+(Mi|Gi|M|G)$",
                  "default": "512Mi"
                },
                "disk": {
                  "type": "string",
                  "description": "Disk space limit (e.g., 1Gi, 10G)",
                  "pattern": "^\\d+(Mi|Gi|M|G)$",
                  "default": "1Gi"
                },
                "timeout": {
                  "type": "string",
                  "description": "Execution timeout (e.g., 300s, 5m)",
                  "pattern": "^\\d+(s|m|h)$",
                  "default": "300s"
                }
              }
            }
          }
        },
        "execution": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "description": "Execution mode",
              "enum": [
                "one-shot",
                "iterative"
              ],
              "default": "one-shot"
            },
            "max_iterations": {
              "type": "integer",
              "description": "Maximum refinement loops",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            },
            "memory": {
              "type": "boolean",
              "description": "Enable Cortex memory system",
              "default": false
            },
            "validation": {
              "type": "array",
              "description": "Ordered list of validation steps executed after each iteration (Vec<ValidatorSpec>). Steps run in declaration order; the first failing step triggers the refinement loop.",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "description": "Passes when the agent's last exit code matches `expected` (default 0).",
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "exit_code"
                        ]
                      },
                      "expected": {
                        "type": "integer",
                        "default": 0
                      },
                      "min_score": {
                        "type": "number",
                        "minimum": 0.0,
                        "maximum": 1.0,
                        "default": 1.0
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "description": "Validates the agent's stdout against a JSON Schema document.",
                    "required": [
                      "type",
                      "schema"
                    ],
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "json_schema"
                        ]
                      },
                      "schema": {
                        "type": "object",
                        "description": "JSON Schema to validate output against"
                      },
                      "min_score": {
                        "type": "number",
                        "minimum": 0.0,
                        "maximum": 1.0,
                        "default": 1.0
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "description": "Validates the agent's output with a regular expression.",
                    "required": [
                      "type",
                      "pattern"
                    ],
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "regex"
                        ]
                      },
                      "pattern": {
                        "type": "string",
                        "description": "Regular expression to match against output"
                      },
                      "target": {
                        "type": "string",
                        "enum": [
                          "stdout",
                          "stderr"
                        ],
                        "default": "stdout"
                      },
                      "min_score": {
                        "type": "number",
                        "minimum": 0.0,
                        "maximum": 1.0,
                        "default": 1.0
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "description": "Spawns a judge agent as a child execution to semantically evaluate output (ADR-016, ADR-017).",
                    "required": [
                      "type",
                      "judge_agent",
                      "criteria"
                    ],
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "semantic"
                        ]
                      },
                      "judge_agent": {
                        "type": "string",
                        "description": "Name of the deployed judge agent to spawn"
                      },
                      "criteria": {
                        "type": "string",
                        "description": "Human-readable evaluation criteria passed to the judge"
                      },
                      "min_score": {
                        "type": "number",
                        "minimum": 0.0,
                        "maximum": 1.0,
                        "default": 0.7
                      },
                      "min_confidence": {
                        "type": "number",
                        "minimum": 0.0,
                        "maximum": 1.0,
                        "default": 0.0
                      },
                      "timeout_seconds": {
                        "type": "integer",
                        "minimum": 1,
                        "default": 300
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "description": "Spawns multiple judge agents in parallel and aggregates their verdicts (ADR-016, ADR-017).",
                    "required": [
                      "type",
                      "judges",
                      "criteria"
                    ],
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "multi_judge"
                        ]
                      },
                      "judges": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 1,
                        "description": "Names of deployed judge agents to spawn"
                      },
                      "consensus": {
                        "type": "string",
                        "enum": [
                          "weighted_average",
                          "majority_vote",
                          "unanimous"
                        ],
                        "default": "weighted_average"
                      },
                      "min_judges_required": {
                        "type": "integer",
                        "minimum": 1,
                        "default": 1
                      },
                      "criteria": {
                        "type": "string",
                        "description": "Human-readable evaluation criteria passed to each judge"
                      },
                      "min_score": {
                        "type": "number",
                        "minimum": 0.0,
                        "maximum": 1.0,
                        "default": 0.7
                      },
                      "min_confidence": {
                        "type": "number",
                        "minimum": 0.0,
                        "maximum": 1.0,
                        "default": 0.0
                      },
                      "timeout_seconds": {
                        "type": "integer",
                        "minimum": 1,
                        "default": 300
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            "tool_validation": {
              "type": "array",
              "description": "Ordered list of inner-loop semantic validation steps executed before tools run.",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "description": "Spawns a judge agent as a child execution to semantically evaluate tool calls before they execute (ADR-049).",
                    "required": [
                      "type",
                      "judge_agent",
                      "criteria"
                    ],
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "semantic"
                        ]
                      },
                      "judge_agent": {
                        "type": "string",
                        "description": "Name of the deployed judge agent to spawn"
                      },
                      "criteria": {
                        "type": "string",
                        "description": "Human-readable evaluation criteria passed to the judge to evaluate the tool call"
                      },
                      "min_score": {
                        "type": "number",
                        "minimum": 0.0,
                        "maximum": 1.0,
                        "default": 0.7
                      },
                      "min_confidence": {
                        "type": "number",
                        "minimum": 0.0,
                        "maximum": 1.0,
                        "default": 0.0
                      },
                      "timeout_seconds": {
                        "type": "integer",
                        "minimum": 1,
                        "default": 60
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        },
        "tools": {
          "type": "array",
          "description": "MCP tools the agent can use",
          "items": {
            "type": "string",
            "pattern": "^(mcp|custom):[a-z0-9-]+$"
          }
        },
        "env": {
          "type": "object",
          "description": "Environment variables (use secret: prefix for secrets)",
          "patternProperties": {
            "^[A-Z_]+$": {
              "type": "string"
            }
          }
        },
        "schedule": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "cron",
                "interval",
                "manual"
              ]
            },
            "cron": {
              "type": "string",
              "description": "Cron expression"
            },
            "timezone": {
              "type": "string",
              "description": "Timezone for schedule"
            },
            "enabled": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "context": {
          "type": "array",
          "description": "Additional resources attached to agent",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "text",
                  "file",
                  "directory",
                  "url"
                ]
              },
              "content": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "volumes": {
          "type": "array",
          "description": "Storage volume mounts for the agent execution",
          "items": {
            "type": "object",
            "required": [
              "name",
              "storage_class",
              "mount_path",
              "access_mode"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Unique volume identifier within the manifest"
              },
              "storage_class": {
                "type": "string",
                "description": "Storage duration class",
                "enum": [
                  "ephemeral",
                  "persistent"
                ]
              },
              "mount_path": {
                "type": "string",
                "description": "Absolute path inside the container where the volume is mounted"
              },
              "access_mode": {
                "type": "string",
                "description": "Access permissions for the volume",
                "enum": [
                  "read-only",
                  "read-write"
                ]
              },
              "ttl_hours": {
                "type": "integer",
                "description": "Time-To-Live in hours; required for ephemeral volumes",
                "minimum": 1
              },
              "size_limit": {
                "type": "string",
                "description": "Maximum volume size as a Kubernetes resource string (e.g., \"500Mi\", \"5Gi\")"
              },
              "source": {
                "type": "object",
                "description": "Volume source; required for persistent volumes",
                "properties": {
                  "volume_id": {
                    "type": "string",
                    "description": "UUID of a pre-created persistent volume (supports template variables, e.g. {{input.dataset_volume_id}})"
                  }
                }
              }
            }
          }
        },
        "delivery": {
          "type": "object",
          "description": "Output delivery configuration",
          "properties": {
            "destinations": {
              "type": "array",
              "description": "Delivery destinations evaluated in order",
              "items": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Unique destination identifier"
                  },
                  "condition": {
                    "type": "string",
                    "description": "When to trigger this destination",
                    "enum": [
                      "on_success",
                      "on_failure",
                      "always"
                    ],
                    "default": "always"
                  },
                  "transform": {
                    "type": "object",
                    "description": "Optional ETL transform applied before delivery",
                    "properties": {
                      "script": {
                        "type": "string",
                        "description": "Path to transform script"
                      },
                      "args": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "timeout_seconds": {
                        "type": "integer",
                        "minimum": 1,
                        "default": 30
                      }
                    }
                  },
                  "type": {
                    "type": "string",
                    "description": "Delivery channel type",
                    "enum": [
                      "email",
                      "webhook",
                      "rest"
                    ]
                  },
                  "email": {
                    "type": "object",
                    "properties": {
                      "to": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        ]
                      },
                      "subject": {
                        "type": "string"
                      },
                      "body_template": {
                        "type": "string"
                      },
                      "attachments": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "webhook": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "method": {
                        "type": "string",
                        "enum": [
                          "POST",
                          "PUT",
                          "PATCH"
                        ],
                        "default": "POST"
                      },
                      "headers": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "rest": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "method": {
                        "type": "string",
                        "enum": [
                          "POST",
                          "PUT",
                          "PATCH"
                        ],
                        "default": "POST"
                      },
                      "headers": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "advanced": {
          "type": "object",
          "description": "Advanced agent configuration",
          "properties": {
            "warm_pool_size": {
              "type": "integer",
              "description": "Number of warm instances to pre-provision",
              "minimum": 0,
              "default": 0
            },
            "swarm_enabled": {
              "type": "boolean",
              "description": "Enable swarm capabilities for spawning child agents",
              "default": false
            },
            "startup_script": {
              "type": "string",
              "description": "Shell script executed before agent code runs"
            },
            "health_check": {
              "type": "object",
              "description": "Health check configuration",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "HTTP path for health check endpoint"
                },
                "interval_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 30
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 5
                }
              }
            }
          }
        }
      }
    }
  }
}