{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEGIS Agent Manifest",
  "description": "Schema for agent.yaml configuration files (K8s-style format)",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "description": "API version following Kubernetes convention",
      "enum": ["100monkeys.ai/v1"]
    },
    "kind": {
      "type": "string",
      "description": "Resource kind",
      "enum": ["Agent"]
    },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique agent name (DNS label format)",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "version": {
          "type": "string",
          "description": "Manifest schema version (semantic versioning)",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description"
        },
        "labels": {
          "type": "object",
          "description": "Key-value labels for categorization",
          "patternProperties": {
            "^[a-z0-9-]+$": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "type": "object",
          "description": "Arbitrary annotations (non-identifying metadata)",
          "patternProperties": {
            "^[a-z0-9-./]+$": {
              "type": "string"
            }
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["runtime"],
      "properties": {
        "runtime": {
          "type": "object",
          "required": ["language", "version"],
          "properties": {
            "language": {
              "type": "string",
              "description": "Programming language",
              "enum": ["python", "javascript", "typescript", "rust", "go"]
            },
            "version": {
              "type": "string",
              "description": "Language version",
              "examples": ["3.11", "20", "1.75"]
            },
            "isolation": {
              "type": "string",
              "description": "Isolation mode",
              "enum": ["inherit", "firecracker", "docker", "process"],
              "default": "inherit"
            },
            "model": {
              "type": "string",
              "description": "Model alias for LLM selection (e.g. 'default', 'fast', 'smart'). Must match an alias configured in the node's spec.llm_providers.",
              "default": "default"
            }
          }
        },
        "task": {
          "type": "object",
          "properties": {
            "agentskills": {
              "type": "array",
              "description": "Pre-built instruction packages",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9-]+:[a-z0-9-]+$"
              }
            },
            "instruction": {
              "type": "string",
              "description": "High-level task guidance"
            },
            "prompt_template": {
              "type": "string",
              "description": "Custom prompt template"
            },
            "input_data": {
              "type": "object",
              "description": "Structured input parameters"
            }
          }
        },
        "security": {
          "type": "object",
          "properties": {
            "network": {
              "type": "object",
              "required": ["mode"],
              "properties": {
                "mode": {
                  "type": "string",
                  "description": "Network access policy mode",
                  "enum": ["allow", "deny", "none"]
                },
                "allowlist": {
                  "type": "array",
                  "description": "Allowed network destinations",
                  "items": {
                    "type": "string"
                  }
                },
                "denylist": {
                  "type": "array",
                  "description": "Denied network destinations",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "filesystem": {
              "type": "object",
              "properties": {
                "read": {
                  "type": "array",
                  "description": "Paths allowed for reading",
                  "items": {
                    "type": "string"
                  }
                },
                "write": {
                  "type": "array",
                  "description": "Paths allowed for writing",
                  "items": {
                    "type": "string"
                  }
                },
                "read_only": {
                  "type": "boolean",
                  "description": "Read-only mode",
                  "default": false
                }
              }
            },
            "resources": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "integer",
                  "description": "CPU limit in millicores (1000 = 1 core)",
                  "minimum": 100,
                  "maximum": 4000,
                  "default": 1000
                },
                "memory": {
                  "type": "string",
                  "description": "Memory limit (e.g., 512Mi, 1Gi)",
                  "pattern": "^\\d+(Mi|Gi|M|G)$",
                  "default": "512Mi"
                },
                "disk": {
                  "type": "string",
                  "description": "Disk space limit (e.g., 1Gi, 10G)",
                  "pattern": "^\\d+(Mi|Gi|M|G)$",
                  "default": "1Gi"
                },
                "timeout": {
                  "type": "string",
                  "description": "Execution timeout (e.g., 300s, 5m)",
                  "pattern": "^\\d+(s|m|h)$",
                  "default": "300s"
                }
              }
            }
          }
        },
        "execution": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "description": "Execution mode",
              "enum": ["one-shot", "iterative"],
              "default": "one-shot"
            },
            "max_iterations": {
              "type": "integer",
              "description": "Maximum refinement loops",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            },
            "memory": {
              "type": "boolean",
              "description": "Enable Cortex memory system",
              "default": false
            },
            "validation": {
              "type": "object",
              "description": "Multi-layer validation strategy",
              "properties": {
                "system": {
                  "type": "object",
                  "description": "System-level checks (exit codes, stderr tolerance)",
                  "properties": {
                    "must_succeed": {
                      "type": "boolean",
                      "description": "Require exit code 0",
                      "default": true
                    },
                    "allow_stderr": {
                      "type": "boolean",
                      "description": "Allow stderr output",
                      "default": false
                    },
                    "timeout_seconds": {
                      "type": "integer",
                      "description": "Per-iteration timeout",
                      "minimum": 1,
                      "default": 300
                    }
                  }
                },
                "output": {
                  "type": "object",
                  "description": "Output format validation (JSON Schema)",
                  "properties": {
                    "format": {
                      "type": "string",
                      "description": "Expected output format",
                      "enum": ["json", "yaml", "text", "csv", "pdf"]
                    },
                    "schema": {
                      "type": "object",
                      "description": "JSON Schema for output validation"
                    },
                    "regex": {
                      "type": "string",
                      "description": "Regex pattern for text output validation"
                    }
                  }
                },
                "script": {
                  "type": "object",
                  "description": "Custom validation script",
                  "properties": {
                    "path": {
                      "type": "string",
                      "description": "Path to validation script"
                    },
                    "description": {
                      "type": "string",
                      "description": "What the script validates"
                    },
                    "timeout_seconds": {
                      "type": "integer",
                      "description": "Script execution timeout",
                      "minimum": 1,
                      "default": 30
                    }
                  }
                },
                "semantic": {
                  "type": "object",
                  "description": "LLM-based semantic validation (Agent-as-Judge)",
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "description": "Enable semantic validation. Defaults to true when task.instruction is present.",
                      "default": true
                    },
                    "model": {
                      "type": "string",
                      "description": "Model alias for judge agent",
                      "default": "default"
                    },
                    "prompt": {
                      "type": "string",
                      "description": "Judge prompt template (use {criteria}, {output}, {exit_code}, {stderr})"
                    },
                    "threshold": {
                      "type": "number",
                      "description": "Minimum confidence required (0.0-1.0)",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 0.8
                    },
                    "timeout_seconds": {
                      "type": "integer",
                      "description": "LLM call timeout",
                      "minimum": 1,
                      "default": 30
                    },
                    "fallback_on_unavailable": {
                      "type": "string",
                      "description": "Behavior when LLM unavailable",
                      "enum": ["skip", "fail"],
                      "default": "skip"
                    }
                  }
                }
              }
            }
          }
        },
        "tools": {
          "type": "array",
          "description": "MCP tools the agent can use",
          "items": {
            "type": "string",
            "pattern": "^(mcp|custom):[a-z0-9-]+$"
          }
        },
        "env": {
          "type": "object",
          "description": "Environment variables (use secret: prefix for secrets)",
          "patternProperties": {
            "^[A-Z_]+$": {
              "type": "string"
            }
          }
        },
        "schedule": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["cron", "interval", "manual"]
            },
            "cron": {
              "type": "string",
              "description": "Cron expression"
            },
            "timezone": {
              "type": "string",
              "description": "Timezone for schedule"
            },
            "enabled": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "context": {
          "type": "array",
          "description": "Additional resources attached to agent",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["text", "file", "directory", "url"]
              },
              "content": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "volumes": {
          "type": "array",
          "description": "Storage volume mounts for the agent execution",
          "items": {
            "type": "object",
            "required": ["name", "storage_class", "mount_point", "access_mode"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Unique volume identifier within the manifest"
              },
              "storage_class": {
                "type": "string",
                "description": "Storage duration class",
                "enum": ["ephemeral", "persistent"]
              },
              "mount_point": {
                "type": "string",
                "description": "Absolute path inside the container where the volume is mounted"
              },
              "access_mode": {
                "type": "string",
                "description": "Access permissions for the volume",
                "enum": ["read-only", "read-write"]
              },
              "ttl_hours": {
                "type": "integer",
                "description": "Time-To-Live in hours; required for ephemeral volumes",
                "minimum": 1
              },
              "size_limit_mb": {
                "type": "integer",
                "description": "Maximum size in megabytes; required for ephemeral volumes",
                "minimum": 1,
                "maximum": 10000,
                "default": 1000
              },
              "source": {
                "type": "object",
                "description": "Volume source; required for persistent volumes",
                "properties": {
                  "volume_id": {
                    "type": "string",
                    "description": "UUID of a pre-created persistent volume (supports template variables, e.g. {{input.dataset_volume_id}})"
                  }
                }
              }
            }
          }
        },
        "delivery": {
          "type": "object",
          "description": "Output delivery configuration",
          "properties": {
            "destinations": {
              "type": "array",
              "description": "Delivery destinations evaluated in order",
              "items": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Unique destination identifier"
                  },
                  "condition": {
                    "type": "string",
                    "description": "When to trigger this destination",
                    "enum": ["on_success", "on_failure", "always"],
                    "default": "always"
                  },
                  "transform": {
                    "type": "object",
                    "description": "Optional ETL transform applied before delivery",
                    "properties": {
                      "script": {
                        "type": "string",
                        "description": "Path to transform script"
                      },
                      "args": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "timeout_seconds": {
                        "type": "integer",
                        "minimum": 1,
                        "default": 30
                      }
                    }
                  },
                  "type": {
                    "type": "string",
                    "description": "Delivery channel type",
                    "enum": ["email", "webhook", "rest"]
                  },
                  "email": {
                    "type": "object",
                    "properties": {
                      "to": {
                        "oneOf": [
                          { "type": "string" },
                          { "type": "array", "items": { "type": "string" } }
                        ]
                      },
                      "subject": { "type": "string" },
                      "body_template": { "type": "string" },
                      "attachments": {
                        "type": "array",
                        "items": { "type": "string" }
                      }
                    }
                  },
                  "webhook": {
                    "type": "object",
                    "properties": {
                      "url": { "type": "string", "format": "uri" },
                      "method": {
                        "type": "string",
                        "enum": ["POST", "PUT", "PATCH"],
                        "default": "POST"
                      },
                      "headers": {
                        "type": "object",
                        "additionalProperties": { "type": "string" }
                      }
                    }
                  },
                  "rest": {
                    "type": "object",
                    "properties": {
                      "url": { "type": "string", "format": "uri" },
                      "method": {
                        "type": "string",
                        "enum": ["POST", "PUT", "PATCH"],
                        "default": "POST"
                      },
                      "headers": {
                        "type": "object",
                        "additionalProperties": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "advanced": {
          "type": "object",
          "description": "Advanced agent configuration",
          "properties": {
            "warm_pool_size": {
              "type": "integer",
              "description": "Number of warm instances to pre-provision",
              "minimum": 0,
              "default": 0
            },
            "swarm_enabled": {
              "type": "boolean",
              "description": "Enable swarm capabilities for spawning child agents",
              "default": false
            },
            "startup_script": {
              "type": "string",
              "description": "Shell script executed before agent code runs"
            },
            "health_check": {
              "type": "object",
              "description": "Health check configuration",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "HTTP path for health check endpoint"
                },
                "interval_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 30
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 5
                }
              }
            }
          }
        }
      }
    }
  }
}
